---
export interface Props {
  page: any; // Astro's Page object
  baseUrl: string;
}

const { page, baseUrl } = Astro.props;

// Helper to remove double slashes while keeping valid routes
const sanitizeUrl = (url: string) => url.replace(/([^:]\/)\/+/g, "$1");
---

<div class="flex items-center justify-center gap-2 my-2">
  {page.url.prev ? (
    <a href={sanitizeUrl(page.url.prev)} class="w-10 h-10 rounded-full flex items-center justify-center border border-border text-text-secondary hover:bg-surface hover:text-primary transition-colors hover:border-primary/50 shadow-sm no-underline" aria-label="이전 페이지">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
    </a>
  ) : (
    <div class="w-10 h-10 rounded-full flex items-center justify-center border border-border/50 text-border bg-gray-50 dark:bg-slate-800 cursor-not-allowed opacity-50" aria-disabled="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
    </div>
  )}

  <!-- Pages -->
  {Array.from({ length: page.lastPage }).map((_, i) => {
    const pageNum = i + 1;
    const isCurrent = page.currentPage === pageNum;
    
    const pageUrl = sanitizeUrl(pageNum === 1 ? baseUrl : `${baseUrl}/${pageNum}`);
    
    return isCurrent ? (
      <div class="w-10 h-10 rounded-full flex items-center justify-center bg-primary text-white font-[600] shadow-sm select-none" aria-current="page">{pageNum}</div>
    ) : (
      <a href={pageUrl} class="w-10 h-10 rounded-full flex items-center justify-center border border-transparent text-text-secondary hover:bg-surface hover:border-border font-[500] transition-all no-underline">{pageNum}</a>
    );
  })}

  {page.url.next ? (
    <a href={sanitizeUrl(page.url.next)} class="w-10 h-10 rounded-full flex items-center justify-center border border-border text-text-secondary hover:bg-surface hover:text-primary transition-colors hover:border-primary/50 shadow-sm no-underline" aria-label="다음 페이지">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
    </a>
  ) : (
    <div class="w-10 h-10 rounded-full flex items-center justify-center border border-border/50 text-border bg-gray-50 dark:bg-slate-800 cursor-not-allowed opacity-50" aria-disabled="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
    </div>
  )}
</div>
