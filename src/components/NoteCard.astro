---
import { Image } from 'astro:assets';

export interface Props {
  post: any; // Astro CollectionEntry<'notes'>
}

const { post } = Astro.props;
const { title, description, category, subcategory, series, seriesOrder, date, thumbnail } = post.data;
const dateStr = date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'numeric', day: 'numeric' });
const excerpt = description || (post.body.substring(0, 150) + (post.body.length > 150 ? '...' : ''));

const getCategoryName = () => {
  if (subcategory) return subcategory;
  return category;
};
---

<article class="note-item py-8 flex flex-col-reverse md:flex-row gap-6 md:gap-12 items-start md:items-center group">
  <div class="flex-1 flex flex-col gap-3">
    <h2 class="text-[22px] font-[700] text-text-title group-hover:text-primary transition-colors leading-[1.4]">
      <a href={`/notes/${post.id}`}>{title}</a>
    </h2>
    <p class="text-[15px] text-text-body leading-[1.7] line-clamp-2">
      {excerpt}
    </p>
    {series && (
      <div class="text-[13px] font-[600] text-primary">
        {series}{seriesOrder ? ` · ${seriesOrder}편` : ''}
      </div>
    )}
    <div class="flex items-center gap-2 text-[13px] text-text-muted mt-2 font-[500]">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
      <span>{getCategoryName()}</span>
      <span>·</span>
      <span>{dateStr}</span>
      
      {/* If tags exist, show the first tag with a link to /tags/tagName */}
      {post.data.tags && post.data.tags.length > 0 && (
        <>
          <span>·</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
          <a href={`/tags/${post.data.tags[0]}`} class="hover:text-primary transition-colors">{post.data.tags[0]}</a>
        </>
      )}
    </div>
  </div>
  {thumbnail && (
    <a href="#" class="w-full md:w-[140px] aspect-square rounded-[var(--radius-card)] bg-gray-100 dark:bg-slate-700/50 border border-border/50 flex-shrink-0 flex items-center justify-center overflow-hidden group-hover:shadow-md transition-all">
      <Image src={thumbnail} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
    </a>
  )}
</article>
