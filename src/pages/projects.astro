---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

const allProjects = await getCollection('projects');

// Order projects (newest period first)
const sorted = allProjects.sort((a, b) =>
  (a.data.order ?? 99) - (b.data.order ?? 99) || b.data.period.localeCompare(a.data.period)
);
const mainProjects = sorted.filter((p) => p.data.type !== 'toy');
const toyProjects = sorted.filter((p) => p.data.type === 'toy');
---

<Layout title="Projects">
  <div class="flex flex-col gap-12">
    <!-- Header Title -->
    <div>
      <h1 class="text-hero-heading">
        IDEAS,<br/>
        <span class="text-gradient-hero">MADE REAL.</span>
      </h1>
      
      <div class="flex flex-wrap gap-3 mt-16" role="tablist">
        <button type="button" class="project-tab is-active" data-tab="main" role="tab" aria-selected="true">
          서비스 <span class="tab-count">{mainProjects.length}</span>
        </button>
        <button type="button" class="project-tab" data-tab="toy" role="tab" aria-selected="false">
          단기 프로젝트 <span class="tab-count">{toyProjects.length}</span>
        </button>
      </div>
      <p data-panel="main" class="project-panel mt-5 text-[15px] text-text-secondary">기획부터 실제 배포까지 마친 프로젝트입니다.</p>
      <p data-panel="toy" class="project-panel mt-5 text-[15px] text-text-secondary" style="display: none;">짧은 기간 동안 하나의 주제에 집중해 진행한 프로젝트입니다.</p>
    </div>

    <!-- Grid Projects -->
    <div id="projects-list" data-panel="main" class="project-panel grid grid-cols-1 md:grid-cols-2 gap-8" data-pagefind-body>
      
      {mainProjects.map((project) => {
        const isLive = project.data.status === 'Live';
        return (
          <div 
            class="project-item bg-surface rounded-[var(--radius-card)] overflow-hidden shadow-sm border border-border/60 flex flex-col group transition-all duration-300 hover:shadow-md"
          >
            <!-- Thumbnail -->
            <div class="w-full bg-gray-100 dark:bg-slate-800/80 relative border-b border-border/60 flex flex-col items-center justify-center overflow-hidden aspect-[16/10]">
              {project.data.thumbnail ? (
                <Image src={project.data.thumbnail} alt={project.data.title} class="w-full h-full object-contain absolute inset-0 z-0" />
              ) : (
                <div class="text-gray-400 dark:text-slate-400 text-[14px] font-medium z-0">No Thumbnail</div>
              )}
              <!-- Status Badge -->
              <div class="absolute bottom-3 right-3 bg-white/90 dark:bg-slate-800/90 backdrop-blur-md text-text-title text-[12px] font-[700] px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow-sm border border-border/70 z-10">
                <span class={`w-2 h-2 rounded-full ${isLive ? 'bg-green-500' : 'bg-blue-500'}`}></span>
                {project.data.status}
              </div>
            </div>

            <!-- Content -->
            <div class="p-[28px] flex flex-col flex-1">
              <h3 class="text-[22px] font-[700] text-text-title mb-1 group-hover:text-primary transition-colors">
                <a href={`/projects/${project.id}`} class="no-underline text-inherit hover:text-primary">
                  {project.data.title}
                </a>
              </h3>
              <div class="text-[14px] text-text-muted mb-4 font-medium">{project.data.period}</div>
              {project.data.affiliation && (
                <div class="text-[14px] font-[600] text-primary mb-2 break-keep">{project.data.affiliation}</div>
              )}
              <p class="text-[15.5px] text-text-body mb-6 leading-[1.65] break-keep whitespace-pre-line">
                {project.data.description}
              </p>

              <!-- Tags / Tech Stack -->
              <div class="flex flex-wrap gap-2 mb-8">
                {project.data.techStack && project.data.techStack.map((tech: string) => (
                  <span class="px-3 py-1 rounded-full bg-gray-100 dark:bg-slate-700/60 text-text-secondary text-sm font-[500] border border-border/40">
                    {tech}
                  </span>
                ))}
              </div>

              <!-- Link Buttons Area -->
              <div class="mt-auto pt-4 border-t border-border/40 flex items-center gap-3 flex-wrap">
                <!-- View Project Button -->
                <a 
                  href={`/projects/${project.id}`} 
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-border text-text-title text-[13.5px] font-[600] hover:border-primary hover:text-primary bg-white dark:bg-slate-800/80 transition-all shadow-sm no-underline"
                >
                  View Project
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </a>

                <!-- GitHub Button (Active or Dimmed/Disabled) -->
                {project.data.githubUrl ? (
                  <a 
                    href={project.data.githubUrl} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="inline-flex items-center gap-2 px-4.5 py-2 rounded-full bg-[#24292E] text-white text-[13.5px] font-[600] hover:bg-[#24292E]/90 transition-all shadow-sm no-underline"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                    GitHub
                  </a>
                ) : (
                  <button 
                    disabled 
                    class="inline-flex items-center gap-2 px-4.5 py-2 rounded-full border border-border/60 bg-surface text-text-muted text-[13.5px] font-[600] opacity-40 cursor-not-allowed select-none pointer-events-none shadow-none"
                    aria-disabled="true"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                    GitHub
                  </button>
                )}
              </div>

            </div>
          </div>
        );
      })}

    </div>

    <!-- Toy Projects -->
    {toyProjects.length > 0 && (
      <section data-panel="toy" class="project-panel" style="display: none;">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-pagefind-body>
          {toyProjects.map((project) => (
            <a
              href={`/projects/${project.id}`}
              class="group flex gap-5 items-center bg-surface rounded-[var(--radius-card)] p-5 shadow-sm border border-border/60 hover:shadow-md hover:border-primary/40 transition-all no-underline"
            >
              <div class="w-28 h-20 shrink-0 rounded-lg overflow-hidden bg-gray-100 dark:bg-slate-800/80 border border-border/60">
                {project.data.thumbnail && (
                  <Image src={project.data.thumbnail} alt={project.data.title} class="w-full h-full object-cover" />
                )}
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="text-[17px] font-[700] text-text-title group-hover:text-primary transition-colors truncate">{project.data.title}</h3>
                <div class="text-[13px] text-text-muted font-medium mt-0.5">{project.data.period}</div>
                <div class="flex flex-wrap gap-1.5 mt-2.5">
                  {project.data.techStack.slice(0, 4).map((tech: string) => (
                    <span class="px-2 py-0.5 rounded-full bg-gray-100 dark:bg-slate-700/60 text-text-secondary text-[12px] font-[500]">{tech}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .project-tab {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 22px; border-radius: 9999px;
    border: 1px solid var(--color-border, #e5e7eb);
    background: var(--color-surface, #fff);
    color: var(--color-text-secondary, #6b7280);
    font-size: 15px; font-weight: 700; cursor: pointer;
    transition: all .2s;
  }
  .project-tab:hover { color: var(--color-text-title, #111827); }
  .project-tab.is-active {
    background: var(--color-text-title, #111827);
    border-color: var(--color-text-title, #111827);
    color: var(--color-surface, #fff);
  }
  .tab-count { font-size: 13px; font-weight: 600; opacity: .6; }
</style>

<script>
  function setupProjectTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.project-tab');
    const panels = document.querySelectorAll<HTMLElement>('.project-panel');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const key = tab.dataset.tab;
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', String(on));
        });
        panels.forEach((p) => { p.style.display = p.dataset.panel === key ? '' : 'none'; });
      });
    });
  }
  document.addEventListener('astro:page-load', setupProjectTabs);
  document.addEventListener('DOMContentLoaded', setupProjectTabs);
</script>
