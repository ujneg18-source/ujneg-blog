</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // ---- Carousel Drag Logic (Enhanced with hold-only & click suppression) ----
    const track = document.getElementById('carousel-track');
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    
    if (track) {
      let isDown = false;
      let startX: number;
      let scrollLeft: number;
      let suppressClick = false;
      let downTimestamp = 0;

      track.querySelectorAll('a, img').forEach(el => {
        el.addEventListener('dragstart', (e) => e.preventDefault());
      });

      track.addEventListener('mousedown', (e) => {
        isDown = true;
        suppressClick = false;
        downTimestamp = Date.now();
        track.classList.add('active');
        startX = (e as MouseEvent).pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });

      const stopDragging = () => {
        if (!isDown) return;
        isDown = false;
        track.classList.remove('active');
      };

      track.addEventListener('mouseleave', stopDragging);
      track.addEventListener('mouseup', stopDragging);
      window.addEventListener('mouseup', stopDragging);

      track.addEventListener('mousemove', (e) => {
        if (!isDown || (e as MouseEvent).buttons === 0) {
          stopDragging();
          return;
        }
        e.preventDefault();
        const x = (e as MouseEvent).pageX - track.offsetLeft;
        const walk = (x - startX) * 1.5;
        if (Math.abs(walk) > 3) {
          suppressClick = true;
        }
        track.scrollLeft = scrollLeft - walk;
      });

      track.querySelectorAll('a').forEach(anchor => {
        anchor.addEventListener('click', (e) => {
          const holdDuration = Date.now() - downTimestamp;
          if (suppressClick || holdDuration > 250) {
            e.preventDefault();
            e.stopPropagation();
          }
        });
      });

      // Button controls
      if (btnPrev && btnNext) {
        const scrollAmount = 300;
        
        btnPrev.addEventListener('click', () => {
          track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        });
        
        btnNext.addEventListener('click', () => {
          track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        });
      }
    }

    // ---- Mobile Touch Flip Logic ----
    const cardInners = document.querySelectorAll('.card-inner');
    cardInners.forEach(inner => {
      inner.addEventListener('click', () => {
        if (window.matchMedia('(max-width: 768px)').matches) {
          inner.classList.toggle('[transform:rotateY(180deg)]');
        }
      });
    });
  });
</script>
