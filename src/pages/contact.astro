---
import Layout from '../layouts/Layout.astro';

// GitHub 저장소 (참여·개발한 프로젝트)
const ghIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>`;
const projects = [
  {
    name: 'feedit',
    type: 'github',
    icon: ghIcon,
    desc: 'FEEDiT — 패션 트렌드 분석·AI 스타일 대화 서비스 (파이널 프로젝트, PM)',
    tags: ['Django', 'Vite', 'PostgreSQL', 'Celery'],
    link: 'https://github.com/feedit-official/feedit'
  },
  {
    name: 'feedit-style-classifier',
    type: 'github',
    icon: ghIcon,
    desc: 'FEEDiT 패션 스타일 분류기 — SigLIP2 임베딩 + Linear Probe',
    tags: ['Python', 'SigLIP2', 'scikit-learn'],
    link: 'https://github.com/ujneg18-source/feedit-style-classifier'
  },
  {
    name: 'SKN31-3rd-1Team',
    type: 'github',
    icon: ghIcon,
    desc: 'AI 치매 정보 알리미 — GraphDB·VectorDB 결합 RAG 챗봇 (PM)',
    tags: ['LangGraph', 'Neo4j', 'Qdrant'],
    link: 'https://github.com/SKNETWORKS-FAMILY-AICAMP/SKN31-3rd-1Team'
  },
  {
    name: 'SKN31-2nd-4Team',
    type: 'github',
    icon: ghIcon,
    desc: 'KKBOX 구독자 이탈 예측 — LightGBM 모델링과 대시보드',
    tags: ['LightGBM', 'XGBoost', 'Streamlit'],
    link: 'https://github.com/SKNETWORKS-FAMILY-AICAMP/SKN31-2nd-4Team'
  },
  {
    name: 'SKN31-1st-2Team',
    type: 'github',
    icon: ghIcon,
    desc: 'F1 Dashboard — 76년치 F1 통계 대시보드 (DB 설계)',
    tags: ['MySQL', 'Streamlit', 'Pandas'],
    link: 'https://github.com/SKNETWORKS-FAMILY-AICAMP/SKN31-1st-2Team'
  },
  {
    name: 'ujneg-blog',
    type: 'github',
    icon: ghIcon,
    desc: '이 블로그 — Astro로 만든 포트폴리오·학습 기록',
    tags: ['Astro', 'Tailwind CSS'],
    link: 'https://github.com/ujneg18-source/ujneg-blog'
  },
];


---

<Layout title="Contact">
  <div class="flex flex-col gap-24">
    
    <!-- 1. Hero Section -->
    <div>
      <h1 class="text-hero-heading">
        LET'S WORK,<br/>
        <span class="text-gradient-hero">TOGETHER.</span>
      </h1>
      <p class="text-[16px] md:text-[18px] text-text-body leading-[1.7] max-w-2xl mt-6">
        채용, 협업 제안, 프로젝트에 대한 질문 모두 환영합니다. 메일(<a href="mailto:ujneg18@gmail.com" class="text-primary hover:underline">ujneg18@gmail.com</a>)이나 아래 방명록으로 남겨 주세요.
      </p>
    </div>

    <!-- 2. Interactive Open Source Carousel -->
    <section class="flex flex-col gap-8">
      <div class="flex items-end justify-between">
        <div>
          <h2 class="text-[28px] font-[800] text-text-title mb-2">GitHub</h2>
          <p class="text-text-secondary text-[15px]">참여하고 만든 프로젝트의 저장소입니다.</p>
        </div>
        <!-- Carousel Controls -->
        <div class="hidden md:flex gap-2">
          <button id="btn-prev" class="w-10 h-10 rounded-full border border-border flex items-center justify-center hover:bg-gray-50 dark:bg-slate-800/50 text-text-secondary transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
          </button>
          <button id="btn-next" class="w-10 h-10 rounded-full border border-border flex items-center justify-center hover:bg-gray-50 dark:bg-slate-800/50 text-text-secondary transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
        </div>
      </div>

      <!-- Draggable Track -->
      <div class="relative -mx-4 px-4 md:mx-0 md:px-0">
        <div 
          id="carousel-track" 
          class="flex gap-6 overflow-x-auto pb-8 pt-4 px-4 -mx-4 md:mx-0 md:px-0 snap-x md:snap-none cursor-grab active:cursor-grabbing"
          style="scrollbar-width: none;"
        >
          <!-- Hide webkit scrollbar -->
          <style>
            #carousel-track::-webkit-scrollbar { display: none; }
          </style>

          {projects.map((proj) => (
            <div class="card-container shrink-0 w-[260px] h-[280px] snap-center [perspective:1000px] group">
              <div class="card-inner relative w-full h-full transition-transform duration-700 [transform-style:preserve-3d] group-hover:[transform:rotateY(180deg)]">
                
                <div class="absolute inset-0 [backface-visibility:hidden] bg-white dark:bg-slate-800 border border-border/70 rounded-2xl shadow-sm flex flex-col items-center justify-center gap-6 p-6">
                  <div class="w-16 h-16 rounded-2xl bg-gray-50 dark:bg-slate-800/50 border border-gray-100 dark:border-slate-700 flex items-center justify-center text-gray-700 dark:text-slate-300 shadow-sm">
                    <Fragment set:html={proj.icon} />
                  </div>
                  <h3 class="text-[18px] font-[700] text-center text-text-title leading-tight">{proj.name}</h3>
                  <span class="text-[12px] font-medium text-text-muted uppercase tracking-wider bg-gray-50 dark:bg-slate-800/50 px-3 py-1 rounded-full">{proj.type}</span>
                </div>

                <div class="absolute inset-0 [backface-visibility:hidden] [transform:rotateY(180deg)] bg-surface border border-border/70 rounded-2xl shadow-sm flex flex-col p-6">
                  <h3 class="text-[16px] font-[700] text-text-title mb-3 truncate">{proj.name}</h3>
                  <p class="text-[14px] text-text-body leading-[1.6] mb-auto line-clamp-4">
                    {proj.desc}
                  </p>
                  
                  <div class="flex flex-wrap gap-1.5 mb-5 mt-4">
                    {proj.tags.map(tag => (
                      <span class="bg-gray-100 dark:bg-slate-700/50 text-text-muted px-2 py-0.5 rounded-md text-[11px] font-medium">{tag}</span>
                    ))}
                  </div>

                  <a href={proj.link} target="_blank" rel="noopener" class="w-full py-2.5 rounded-lg bg-gray-900 dark:bg-slate-100 text-white text-center text-[13px] font-[600] hover:bg-gray-800 dark:bg-slate-200 transition-colors flex items-center justify-center gap-2">
                    View on GitHub
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Guestbook Section (Mockup) -->
    <section class="flex flex-col gap-8 max-w-[800px] w-full mx-auto bg-white dark:bg-slate-800 border border-border/50 rounded-2xl p-8 md:p-10 shadow-sm">
      <div class="flex items-center gap-3 border-b border-border/50 pb-6">
        <h2 class="text-[22px] font-[800] text-text-title">방명록</h2>
      </div>

      <div class="mt-4 w-full">
        <script src="https://giscus.app/client.js"
                data-repo="ujneg18-source/ujneg-blog"
                data-repo-id="R_kgDOTiV-Lw"
                data-category="Announcements"
                data-category-id="DIC_kwDOTiV-L84DB4CF"
                data-mapping="pathname"
                data-strict="0"
                data-reactions-enabled="1"
                data-emit-metadata="0"
                data-input-position="bottom"
                data-theme="preferred_color_scheme"
                data-lang="ko"
                crossorigin="anonymous"
                async>
        </script>
      </div>
    </section>

  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // ---- Carousel Drag Logic (Enhanced with hold-only & click suppression) ----
    const track = document.getElementById('carousel-track');
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    
    if (track) {
      let isDown = false;
      let startX: number;
      let scrollLeft: number;
      let suppressClick = false;
      let downTimestamp = 0;

      track.querySelectorAll('a, img').forEach(el => {
        el.addEventListener('dragstart', (e) => e.preventDefault());
      });

      track.addEventListener('mousedown', (e) => {
        isDown = true;
        suppressClick = false;
        downTimestamp = Date.now();
        track.classList.add('active');
        startX = (e as MouseEvent).pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });

      const stopDragging = () => {
        if (!isDown) return;
        isDown = false;
        track.classList.remove('active');
      };

      track.addEventListener('mouseleave', stopDragging);
      track.addEventListener('mouseup', stopDragging);
      window.addEventListener('mouseup', stopDragging);

      track.addEventListener('mousemove', (e) => {
        if (!isDown || (e as MouseEvent).buttons === 0) {
          stopDragging();
          return;
        }
        e.preventDefault();
        const x = (e as MouseEvent).pageX - track.offsetLeft;
        const walk = (x - startX) * 1.5;
        if (Math.abs(walk) > 3) {
          suppressClick = true;
        }
        track.scrollLeft = scrollLeft - walk;
      });

      track.querySelectorAll('a').forEach(anchor => {
        anchor.addEventListener('click', (e) => {
          const holdDuration = Date.now() - downTimestamp;
          if (suppressClick || holdDuration > 250) {
            e.preventDefault();
            e.stopPropagation();
          }
        });
      });

      // Button controls
      if (btnPrev && btnNext) {
        const scrollAmount = 300;
        
        btnPrev.addEventListener('click', () => {
          track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        });
        
        btnNext.addEventListener('click', () => {
          track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        });
      }
    }

    // ---- Mobile Touch Flip Logic ----
    const cardInners = document.querySelectorAll('.card-inner');
    cardInners.forEach(inner => {
      inner.addEventListener('click', () => {
        if (window.matchMedia('(max-width: 768px)').matches) {
          inner.classList.toggle('[transform:rotateY(180deg)]');
        }
      });
    });
  });
</script>
