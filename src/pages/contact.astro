                  <p class="text-[14px] text-text-body leading-[1.6] mb-auto line-clamp-4">
                    {proj.desc}
                  </p>
                  
                  <div class="flex flex-wrap gap-1.5 mb-5 mt-4">
                    {proj.tags.map(tag => (
                      <span class="bg-gray-100 dark:bg-slate-700/50 text-text-muted px-2 py-0.5 rounded-md text-[11px] font-medium">{tag}</span>
                    ))}
                  </div>

                  <a href={proj.link} class="w-full py-2.5 rounded-lg bg-gray-900 dark:bg-slate-100 text-white text-center text-[13px] font-[600] hover:bg-gray-800 dark:bg-slate-200 transition-colors flex items-center justify-center gap-2">
