---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import profileImg from '../assets/images/pages/about/profile-image-kka.png';
import workingOnImg from '../assets/images/pages/about/working-on-illustration.png';
---

<Layout title="About">
  <div class="flex flex-col gap-12">
    <!-- Intro Section (Method B: Wide Horizontal Banner Layout) -->
    <section class="relative w-full rounded-[24px] overflow-hidden bg-[#F8F7FD] dark:bg-slate-900 shadow-sm border border-border/50 min-h-[420px] flex items-center p-8 md:p-12 lg:p-16">
      <!-- Background Image Layer (Showcasing right illustration across the landscape format) -->
      {profileImg.format === 'gif' ? (
        <img src={profileImg.src} alt="Profile Background" width={profileImg.width} height={profileImg.height} class="absolute inset-0 w-full h-full object-cover object-[85%_center] md:object-right transition-transform duration-500 dark:brightness-[0.85] dark:contrast-[1.05]" />
      ) : (
        <Image src={profileImg} alt="Profile Background" class="absolute inset-0 w-full h-full object-cover object-[85%_center] md:object-right transition-transform duration-500 dark:brightness-[0.85] dark:contrast-[1.05]" />
      )}
      
      <!-- Gradient Overlay for Seamless Readability in Light & Dark Modes -->
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 via-60% to-transparent dark:from-slate-900 dark:via-slate-900/85 dark:to-slate-900/35"></div>
      
      <!-- Text & Socials Layer -->
      <div class="relative z-10 flex flex-col gap-5 max-w-xl">
        <div class="flex flex-col gap-2">
          <span class="text-sm font-bold tracking-widest text-text-secondary uppercase">AI ENGINEER</span>
          <h1 class="text-hero-heading mb-0">
            About <span class="text-gradient-hero">Me</span>
          </h1>
        </div>
        
        <ul class="text-[16px] text-text-body font-[500] leading-relaxed space-y-2 list-disc list-inside mt-1">
          <li>작은 아이디어를 현실로 만드는 것을 좋아합니다.</li>
          <li>AI를 활용해 사람들의 일상에 도움이 되는 제품을 만들고 싶습니다.</li>
          <li>국어를 가르치던 사람에서 개발자로, 매일 배우고 기록하며 연구합니다.</li>
          <li>언어를 이해하는 시선으로 사람과 AI를 연결합니다 :)</li>
        </ul>

        <!-- Social Icons -->
        <div class="flex items-center gap-4 mt-2">
          <a href="#" class="w-10 h-10 rounded-full bg-surface border border-border flex items-center justify-center text-text-secondary hover:text-text-title hover:border-text-secondary transition-colors shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-full bg-surface border border-border flex items-center justify-center text-text-secondary hover:text-text-title hover:border-text-secondary transition-colors shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-full bg-surface border border-border flex items-center justify-center text-text-secondary hover:text-text-title hover:border-text-secondary transition-colors shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-full bg-surface border border-border flex items-center justify-center text-text-secondary hover:text-text-title hover:border-text-secondary transition-colors shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Profile Section -->
    <section class="mt-4">
      <div class="bg-surface rounded-[var(--radius-card)] p-8 shadow-sm border border-border/50">
        <h3 class="text-[22px] font-[700] text-primary mb-6">Profile</h3>
        
        <div class="flex flex-col gap-4 text-[14px]">
          <div class="grid grid-cols-[80px_1fr] gap-4">
            <span class="text-text-secondary">이름</span>
            <span class="text-text-title font-[500]">유진영 (JINYEONG YOO)</span>
          </div>
          <div class="grid grid-cols-[80px_1fr] gap-4">
            <span class="text-text-secondary">생년월일</span>
            <span class="text-text-title font-[500]">1999.01.17</span>
          </div>
          <div class="grid grid-cols-[80px_1fr] gap-4">
            <span class="text-text-secondary">연락처</span>
            <span class="text-text-title font-[500]">000-0000-0000</span>
          </div>
          <div class="grid grid-cols-[80px_1fr] gap-4">
            <span class="text-text-secondary">이메일</span>
            <span class="text-text-title font-[500]">jinyeong.yoo@example.com</span>
          </div>
          <div class="grid grid-cols-[80px_1fr] gap-4 items-center">
            <span class="text-text-secondary">관심사</span>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 rounded-[var(--radius-tag)] bg-[#EFF6FF] text-[#2563EB] text-[13px] font-medium">AI</span>
              <span class="px-3 py-1 rounded-[var(--radius-tag)] bg-[#ECFDF5] text-[#15803D] text-[13px] font-medium">NLP</span>
              <span class="px-3 py-1 rounded-[var(--radius-tag)] bg-[#F5F3FF] text-[#7C3AED] text-[13px] font-medium">LLM</span>
              <span class="px-3 py-1 rounded-[var(--radius-tag)] bg-[#FFF7ED] text-[#C2410C] text-[13px] font-medium">Product</span>
              <span class="px-3 py-1 rounded-[var(--radius-tag)] bg-[#EFF6FF] text-[#2563EB] text-[13px] font-medium">Education</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Work Experience Section -->
    <section class="mt-4">
      <div class="bg-surface rounded-[var(--radius-card)] p-8 shadow-sm border border-border/50">
        <h3 class="text-[22px] font-[700] text-primary mb-8">Work Experience</h3>
        
        <div class="flex flex-col gap-10">
          <!-- Experience Item 1 -->
          <div class="flex flex-col md:flex-row gap-4 md:gap-8">
            <div class="md:w-48 shrink-0">
              <h4 class="text-text-title font-[700] text-[16px]">SKN31 부트캠프</h4>
              <div class="text-text-secondary text-[14px] mt-1">2024.01 - 2024.06</div>
            </div>
            <div class="flex-1">
              <h5 class="text-text-title font-[600] text-[15px] mb-3">AI 프로젝트 팀장</h5>
              <ul class="list-disc list-outside ml-4 text-[14px] text-text-body space-y-2 mb-4">
                <li>LLM 기반 한국어 가독성 분석 및 글쓰기 피드백 서비스 '환희' 기획 및 개발</li>
                <li>RAG 파이프라인 구축 및 프롬프트 엔지니어링</li>
                <li>팀 프로젝트 리딩, 일정 관리 및 GitHub 형상 관리</li>
              </ul>
              <div class="flex flex-wrap gap-2 mt-2">
                <span class="px-3 py-1 rounded-[var(--radius-tag)] bg-[#ECFDF5] text-[#15803D] text-[12px] font-medium">Python</span>
                <span class="px-3 py-1 rounded-[var(--radius-tag)] bg-[#FEF2F2] text-[#DC2626] text-[12px] font-medium">RAG</span>
                <span class="px-3 py-1 rounded-[var(--radius-tag)] bg-[#EFF6FF] text-[#2563EB] text-[12px] font-medium">LLM</span>
              </div>
            </div>
          </div>

          <!-- Divider -->
          <hr class="border-border/50" />

          <!-- Experience Item 2 -->
          <div class="flex flex-col md:flex-row gap-4 md:gap-8">
            <div class="md:w-48 shrink-0">
              <h4 class="text-text-title font-[700] text-[16px]">국어 강사</h4>
              <div class="text-text-secondary text-[14px] mt-1">2021.03 - 2023.12</div>
            </div>
            <div class="flex-1">
              <h5 class="text-text-title font-[600] text-[15px] mb-3">전임 강사</h5>
              <ul class="list-disc list-outside ml-4 text-[14px] text-text-body space-y-2 mb-4">
                <li>고등부 국어/논술 강의 및 교재 집필</li>
                <li>학생 상담 및 성적 관리, 커리큘럼 기획</li>
                <li>비문학 독해력 향상을 위한 자체 학습법 고안</li>
              </ul>
              <div class="flex flex-wrap gap-2 mt-2">
                <span class="px-3 py-1 rounded-[var(--radius-tag)] bg-bg-base border border-border text-text-secondary text-[12px] font-medium">Education</span>
                <span class="px-3 py-1 rounded-[var(--radius-tag)] bg-bg-base border border-border text-text-secondary text-[12px] font-medium">Communication</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Currently Working On Section -->
    <section class="mt-4">
      <div class="bg-surface rounded-[var(--radius-card)] p-8 shadow-sm border border-border/50 flex flex-col md:flex-row gap-6 items-center">
        <div class="flex-1">
          <h3 class="text-[22px] font-[700] text-primary mb-6">Currently Working On</h3>
          <ul class="flex flex-col gap-3 text-[14px] text-text-title font-[500]">
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0 mt-0.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
              환희 Recommendation
            </li>
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0 mt-0.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
              Korean Readability Dataset
            </li>
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0 mt-0.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
              Korean Embedding Benchmark
            </li>
            <li class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0 mt-0.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
              AI PM Portfolio
            </li>
          </ul>
        </div>
        
        <div class="w-[140px] aspect-video bg-gray-100 dark:bg-slate-700/50 rounded-lg shrink-0 overflow-hidden relative shadow-inner border border-border/50 flex items-center justify-center">
           <Image src={workingOnImg} alt="Working On" class="w-full h-full object-cover opacity-0 absolute inset-0" />
           <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-muted opacity-50"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
           <div class="absolute bottom-2 text-[10px] text-text-muted opacity-50 text-center px-2">Replace<br/>working-on-illustration.png</div>
        </div>
      </div>
    </section>
  </div>
</Layout>
