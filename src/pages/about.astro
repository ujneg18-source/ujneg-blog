---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import profileImg from '../assets/images/pages/about/profile-image-kka.png';

// ── 연락처 ──────────────────────────────────────────────
const EMAIL = 'ujneg18@gmail.com';
const GITHUB = 'https://github.com/ujneg18-source';
// LinkedIn을 만들면 주소를 넣으면 아이콘이 나타난다
const LINKEDIN = '';

// ── 이력 데이터 (최신 이력서 기준) ─────────────────────────
const education = [
  {
    org: '경희대학교',
    period: '2018.03 – 2024.02',
    role: '국어국문학과 학사 졸업',
    items: ['학점 4.15 / 4.5', '국어학·국어정보학·응용언어학·한국어교육론 등 언어 전공 이수'],
  },
  {
    org: '용인삼계고등학교',
    period: '2015.03 – 2018.02',
    role: '인문계열 졸업',
    items: [],
  },
];

const training = [
  {
    org: 'SK네트웍스 Family AI 캠프 31기',
    period: '2026.04 – 2026.10',
    role: '플레이데이터평생교육원 · 960시간 수료',
    items: [
      '프로그래밍·데이터 기초: Python, SQL, Web Crawling, 데이터 전처리',
      '데이터 분석·ML/DL: 머신러닝·딥러닝 모델 학습·검증 및 평가',
      'LLM·생성형 AI: NLP, 프롬프트 엔지니어링, RAG, Agent, 파인튜닝',
      'AI 애플리케이션 개발: Django, 웹, AWS 배포, 소프트웨어 공학',
      '팀 프로젝트 PM·팀장: 도란도란, 치매정보알리미, FEEDiT',
    ],
    tags: ['Python', 'LLM', 'RAG', 'LangGraph', 'Django', 'AWS'],
  },
];

const career = [
  {
    org: '기파랑문해원',
    period: '2024.03 – 2025.02',
    role: '국어 강사',
    items: [
      '중·고등 국어 강의와 학생·학부모 약 150명 관리',
      '출결·과제 수행률·월간 모의고사 성적을 데이터화해 학생별로 관리',
      'Excel(VLOOKUP·피벗테이블) 기반 상담 자료 표준화로 상담 효율 개선',
      '정기 상담과 학부모 응대, 재등록률 안정적 유지',
    ],
    tags: ['Education', 'Data', 'Communication'],
  },
];

const awards = [
  {
    org: '문화체육관광부 장관상',
    period: '2026.08',
    role: '제4회 문화체육관광 인공지능·데이터 활용 공모전 대상(1위)',
    items: [
      '문화데이터 활용 우수사례 부문(제품·서비스) — 서비스명 「도란도란」',
      '한국 전통 설화에 AI를 결합해 아이의 문해력 수준에 맞춘 동화를 제공',
      '활용 데이터: 한국민속문학사전(국립민속박물관), 기초어휘 등급화 연구(국립국어원)',
    ],
  },
];

const activities = [
  {
    org: '고용노동부 정책기자단 14기',
    period: '2022.03 – 2022.11',
    role: '시민기자',
    items: [
      '고용노동부 정책 홍보 및 콘텐츠 기획',
      '주요 정책을 블로그 기사·카드뉴스·영상 콘텐츠로 제작해 총 6회 배포',
      '정책 현장 탐방, 정책 수혜자 및 전문가 인터뷰 진행',
      '격월 기획회의, 워크숍, 팸투어 등 온·오프라인 활동',
    ],
  },
  {
    org: '경희대학교 유학생 멘토링',
    period: '2021.09 – 2021.11',
    role: '멘토 (교육봉사 32시간)',
    items: [
      '중국인 유학생 대상 한국어 학습 지도 및 대학 생활 적응 지원',
      '언어·문화적 장벽 해소를 위한 1:1 맞춤형 커뮤니케이션',
      '정기 학습 스케줄 관리 및 학업 성취도 모니터링',
    ],
  },
  {
    org: '축구동아리 활개FC',
    period: '2018.04 – 2024.02',
    role: '패장',
    items: [
      '회원 30명 규모 조직 운영 및 경기 일정 조율',
      '동아리 SNS 운영 및 홍보',
      '신입 회원 모집 체계 정비 및 참여율 개선',
      '팀 내 갈등 조율 및 운영 안정화',
    ],
  },
];

const certificates = [
  { name: '공인노무사 1차 시험 합격', date: '2022.05' },
  { name: '자동차운전면허 1종 보통', date: '' },
];


const sections = [
  { title: '학력사항', list: education },
  { title: '교육사항', list: training },
  { title: '이력사항', list: career },
  { title: '수상이력', list: awards },
  { title: '대외활동', list: activities },
];
---

<Layout title="About">
  <div class="flex flex-col gap-12">
    <!-- Intro -->
    <section class="relative w-full rounded-[24px] overflow-hidden bg-[#F8F7FD] dark:bg-slate-900 shadow-sm border border-border/50 min-h-[420px] flex items-center p-8 md:p-12 lg:p-16">
      {profileImg.format === 'gif' ? (
        <img src={profileImg.src} alt="" width={profileImg.width} height={profileImg.height} class="absolute inset-0 w-full h-full object-cover object-[85%_center] md:object-right dark:brightness-[0.85] dark:contrast-[1.05]" />
      ) : (
        <Image src={profileImg} alt="" class="absolute inset-0 w-full h-full object-cover object-[85%_center] md:object-right dark:brightness-[0.85] dark:contrast-[1.05]" />
      )}
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 via-60% to-transparent dark:from-slate-900 dark:via-slate-900/85 dark:to-slate-900/35"></div>

      <div class="relative z-10 flex flex-col gap-5 max-w-xl">
        <div class="flex flex-col gap-2">
          <span class="text-sm font-bold tracking-widest text-text-secondary uppercase">AI Product Engineer</span>
          <h1 class="text-hero-heading mb-0">About <span class="text-gradient-hero">Me</span></h1>
        </div>

        <ul class="text-[16px] text-text-body font-[500] leading-relaxed space-y-2 list-disc list-inside mt-1">
          <li>국어국문학을 전공했고, 국어 강사로 일했습니다.</li>
          <li>SK네트웍스 AI 캠프에서 LLM·RAG 서비스를 직접 기획하고 만들며 배웠습니다.</li>
          <li>아이 문해력 맞춤 동화 서비스 '도란도란'으로 문화체육관광부 장관상을 받았습니다.</li>
        </ul>

        <div class="flex items-center gap-4 mt-2">
          <a href={`mailto:${EMAIL}`} aria-label="Email" class="w-10 h-10 rounded-full bg-surface border border-border flex items-center justify-center text-text-secondary hover:text-text-title hover:border-text-secondary transition-colors shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </a>
          <a href={GITHUB} target="_blank" rel="noopener" aria-label="GitHub" class="w-10 h-10 rounded-full bg-surface border border-border flex items-center justify-center text-text-secondary hover:text-text-title hover:border-text-secondary transition-colors shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          </a>
          <a href={LINKEDIN || '#'} aria-label="LinkedIn" class="w-10 h-10 rounded-full bg-surface border border-border flex items-center justify-center text-text-secondary hover:text-text-title hover:border-text-secondary transition-colors shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
          <a href="#" aria-label="X" class="w-10 h-10 rounded-full bg-surface border border-border flex items-center justify-center text-text-secondary hover:text-text-title hover:border-text-secondary transition-colors shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Profile -->
    <section class="mt-4">
      <div class="bg-surface rounded-[var(--radius-card)] p-8 shadow-sm border border-border/50">
        <h3 class="text-[22px] font-[700] text-primary mb-6">Profile</h3>
        <div class="flex flex-col gap-4 text-[14px]">
          <div class="grid grid-cols-[80px_1fr] gap-4">
            <span class="text-text-secondary">이름</span>
            <span class="text-text-title font-[500]">유진영 (YOO JINYEONG)</span>
          </div>
          <div class="grid grid-cols-[80px_1fr] gap-4">
            <span class="text-text-secondary">이메일</span>
            <a href={`mailto:${EMAIL}`} class="text-text-title font-[500] hover:text-primary no-underline">{EMAIL}</a>
          </div>
          <div class="grid grid-cols-[80px_1fr] gap-4">
            <span class="text-text-secondary">GitHub</span>
            <a href={GITHUB} target="_blank" rel="noopener" class="text-text-title font-[500] hover:text-primary no-underline">{GITHUB.replace('https://', '')}</a>
          </div>
          <div class="grid grid-cols-[80px_1fr] gap-4 items-center">
            <span class="text-text-secondary">관심사</span>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 rounded-[var(--radius-tag)] bg-[#EFF6FF] text-[#2563EB] text-[13px] font-medium">AI 서비스 기획</span>
              <span class="px-3 py-1 rounded-[var(--radius-tag)] bg-[#F5F3FF] text-[#7C3AED] text-[13px] font-medium">LLM · Agent</span>
              <span class="px-3 py-1 rounded-[var(--radius-tag)] bg-[#ECFDF5] text-[#15803D] text-[13px] font-medium">NLP</span>
              <span class="px-3 py-1 rounded-[var(--radius-tag)] bg-[#FFF7ED] text-[#C2410C] text-[13px] font-medium">Technical Writing</span>
              <span class="px-3 py-1 rounded-[var(--radius-tag)] bg-[#EFF6FF] text-[#2563EB] text-[13px] font-medium">Education</span>
            </div>
          </div>
          <div class="grid grid-cols-[80px_1fr] gap-4 items-start">
            <span class="text-text-secondary pt-1">스킬</span>
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-[var(--radius-tag)] bg-surface border border-border text-text-title text-[13px] font-medium"><svg viewBox="0 0 24 24" width="14" height="14" fill="#3776AB" aria-hidden="true"><path d="M14.25.18l.9.2.73.26.59.3.45.32.34.34.25.34.16.33.1.3.04.26.02.2-.01.13V8.5l-.05.63-.13.55-.21.46-.26.38-.3.31-.33.25-.35.19-.35.14-.33.1-.3.07-.26.04-.21.02H8.77l-.69.05-.59.14-.5.22-.41.27-.33.32-.27.35-.2.36-.15.37-.1.35-.07.32-.04.27-.02.21v3.06H3.17l-.21-.03-.28-.07-.32-.12-.35-.18-.36-.26-.36-.36-.35-.46-.32-.59-.28-.73-.21-.88-.14-1.05-.05-1.23.06-1.22.16-1.04.24-.87.32-.71.36-.57.4-.44.42-.33.42-.24.4-.16.36-.1.32-.05.24-.01h.16l.06.01h8.16v-.83H6.18l-.01-2.75-.02-.37.05-.34.11-.31.17-.28.25-.26.31-.23.38-.2.44-.18.51-.15.58-.12.64-.1.71-.06.77-.04.84-.02 1.27.05zm-6.3 1.98l-.23.33-.08.41.08.41.23.34.33.22.41.09.41-.09.33-.22.23-.34.08-.41-.08-.41-.23-.33-.33-.22-.41-.09-.41.09zm13.09 3.95l.28.06.32.12.35.18.36.27.36.35.35.47.32.59.28.73.21.88.14 1.04.05 1.23-.06 1.23-.16 1.04-.24.86-.32.71-.36.57-.4.45-.42.33-.42.24-.4.16-.36.09-.32.05-.24.02-.16-.01h-8.22v.82h5.84l.01 2.76.02.36-.05.34-.11.31-.17.29-.25.25-.31.24-.38.2-.44.17-.51.15-.58.13-.64.09-.71.07-.77.04-.84.01-1.27-.04-1.07-.14-.9-.2-.73-.25-.59-.3-.45-.33-.34-.34-.25-.34-.16-.33-.1-.3-.04-.25-.02-.2.01-.13v-5.34l.05-.64.13-.54.21-.46.26-.38.3-.32.33-.24.35-.2.35-.14.33-.1.3-.06.26-.04.21-.02.13-.01h5.84l.69-.05.59-.14.5-.21.41-.28.33-.32.27-.35.2-.36.15-.36.1-.35.07-.32.04-.28.02-.21V6.07h2.09l.14.01zm-6.47 14.25l-.23.33-.08.41.08.41.23.33.33.23.41.08.41-.08.33-.23.23-.33.08-.41-.08-.41-.23-.33-.33-.23-.41-.08-.41.08z"/></svg>Python</span>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-[var(--radius-tag)] bg-surface border border-border text-text-title text-[13px] font-medium"><svg viewBox="0 0 24 24" width="14" height="14" fill="#7FC8FF" aria-hidden="true"><path d="M5 19H10A5 5 0 115 14ZM19 14A5 5 0 1114 19H19ZM10 5A5 5 0 105 10V5ZM19 5V10A5 5 0 1014 5Z"/></svg>LangGraph</span>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-[var(--radius-tag)] bg-surface border border-border text-text-title text-[13px] font-medium"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M11.146 0h3.924v18.166c-2.013.382-3.491.535-5.096.535-4.791 0-7.288-2.166-7.288-6.32 0-4.002 2.65-6.6 6.753-6.6.637 0 1.121.05 1.707.203zm0 9.143a3.894 3.894 0 00-1.325-.204c-1.988 0-3.134 1.223-3.134 3.365 0 2.09 1.096 3.236 3.109 3.236.433 0 .79-.025 1.35-.102V9.142zM21.314 6.06v9.098c0 3.134-.229 4.638-.917 5.937-.637 1.249-1.478 2.039-3.211 2.905l-3.644-1.733c1.733-.815 2.574-1.53 3.109-2.625.561-1.121.739-2.421.739-5.835V6.059h3.924zM17.39.021h3.924v4.026H17.39z"/></svg>Django</span>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-[var(--radius-tag)] bg-surface border border-border text-text-title text-[13px] font-medium"><svg viewBox="0 0 24 24" width="14" height="14" fill="#009688" aria-hidden="true"><path d="M12 .0387C5.3729.0384.0003 5.3931 0 11.9988c-.001 6.6066 5.372 11.9628 12 11.9625 6.628.0003 12.001-5.3559 12-11.9625-.0003-6.6057-5.3729-11.9604-12-11.96m-.829 5.4153h7.55l-7.5805 5.3284h5.1828L5.279 18.5436q2.9466-6.5444 5.892-13.0896"/></svg>FastAPI</span>
