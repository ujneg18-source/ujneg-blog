---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroImg from '../assets/images/pages/home/hero-illustration.gif';

// Fetch all content collections for real stats & latest updates
const allProjects = await getCollection('projects');
const allNotes = await getCollection('notes');
const allStories = await getCollection('stories');

const projectsCount = allProjects.length;
const notesCount = allNotes.length;
const storiesCount = allStories.length;
const githubContribCount = 24; // realistic contribution number aligning with 7~8 repos

// Helper to format Date objects
const formatFullDate = (d: Date): string => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}.${m}.${day}`;
};

// Helper to convert project period string (e.g. "2024.01 - 2024.06") to numeric timestamp for sorting
const parsePeriodTimestamp = (periodStr: string): number => {
  const parts = periodStr.split('-').map(p => p.trim());
  const target = parts[parts.length - 1] || parts[0] || '';
  const match = target.match(/(\d{4})[.\-/]?(\d{2})?/);
  if (match) {
    const year = parseInt(match[1], 10);
    const month = match[2] ? parseInt(match[2], 10) - 1 : 0;
    return new Date(year, month, 15).valueOf();
  }
  return 0;
};

// Combine all items into a unified array
const unifiedItems = [
  ...allProjects.map(p => ({
    id: p.id,
    type: 'Project',
    title: p.data.title,
    dateStr: p.data.period,
    timestamp: parsePeriodTimestamp(p.data.period),
    thumbnail: p.data.thumbnail,
    href: `/projects/${p.id}`,
    description: p.data.description || ''
  })),
  ...allNotes.map(n => ({
    id: n.id,
    type: 'Note',
    title: n.data.title,
    dateStr: formatFullDate(n.data.date),
    timestamp: n.data.date.valueOf(),
    thumbnail: null,
    href: `/notes/${n.id}`,
    description: n.data.description || '개인 공부 기록 및 아키텍처 정리 노트'
  })),
  ...allStories.map(s => ({
    id: s.id,
    type: 'Story',
    title: s.data.title,
    dateStr: formatFullDate(s.data.date),
    timestamp: s.data.date.valueOf(),
    thumbnail: s.data.thumbnail,
    href: `/stories/${s.id}`,
    description: s.data.description || ''
  }))
];

// Sort by newest first across all collections, and slice top 6
const latestUpdates = unifiedItems.sort((a, b) => b.timestamp - a.timestamp).slice(0, 6);
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="flex flex-col gap-6 pb-12 md:pb-20">
    <div class="relative w-full rounded-[24px] overflow-hidden bg-gray-100 dark:bg-slate-700/50 shadow-sm border border-border/50 min-h-[480px] flex items-center p-8 md:p-12 lg:p-16">
      <!-- Background Image Layer -->
      {heroImg.format === 'gif' ? (
        <img src={heroImg.src} alt="Hero Illustration" width={heroImg.width} height={heroImg.height} class="absolute inset-0 w-full h-full object-cover" />
      ) : (
        <Image src={heroImg} alt="Hero Illustration" class="absolute inset-0 w-full h-full object-cover" />
      )}
      
      <!-- Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-white/90 via-white/70 to-transparent dark:from-slate-900/90 dark:via-slate-900/70 dark:to-transparent"></div>
      
      <!-- Content Layer -->
      <div class="relative z-10 flex flex-col items-start gap-6 max-w-2xl">
        <h1 class="text-hero-heading">
          Learning more,<br/>
          <span class="text-gradient-hero">Growing better.</span>
        </h1>
        
        <p class="text-[var(--text-body)] text-text-body font-[var(--font-weight-body-light)] leading-relaxed max-w-lg">
          작은 아이디어를 현실로 만드는 것을 좋아합니다.<br/>
          AI를 활용해 사람들의 일상에 도움이 되는<br/>
          제품을 만들고 싶습니다.
        </p>

        <div class="font-['Caveat'] text-4xl text-secondary-blue opacity-80 mt-2 mb-4">
          Carpe diem.
        </div>

        <div class="flex flex-wrap gap-4">
          <a href="/projects" class="flex items-center gap-2 px-6 py-3 rounded-[var(--radius-btn)] bg-surface border border-border shadow-sm hover:shadow-[var(--shadow-card-hover)] hover:border-primary/30 transition-all font-medium text-sm no-underline text-text-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
            프로젝트 보기
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1 opacity-50"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="/notes" class="flex items-center gap-2 px-6 py-3 rounded-[var(--radius-btn)] bg-surface border border-border shadow-sm hover:shadow-[var(--shadow-card-hover)] hover:border-primary/30 transition-all font-medium text-sm no-underline text-text-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
            개인 공부 기록
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1 opacity-50"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="/stories" class="flex items-center gap-2 px-6 py-3 rounded-[var(--radius-btn)] bg-surface border border-border shadow-sm hover:shadow-[var(--shadow-card-hover)] hover:border-primary/30 transition-all font-medium text-sm no-underline text-text-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path><path d="M2 2l7.586 7.586"></path><circle cx="11" cy="11" r="2"></circle></svg>
            스토리 보기
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1 opacity-50"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section (Connected to live data) -->
  <section class="py-12 border-t border-b border-border border-dashed">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-x divide-transparent md:divide-border/50">
      
      <div class="flex flex-col items-center justify-center text-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mb-3"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
        <span class="text-[36px] font-[800] text-text-title leading-none mb-1">{projectsCount}</span>
        <span class="text-[14.5px] font-[600] text-text-secondary">Projects</span>
      </div>

      <div class="flex flex-col items-center justify-center text-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mb-3"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
        <span class="text-[36px] font-[800] text-text-title leading-none mb-1">{notesCount}</span>
        <span class="text-[14.5px] font-[600] text-text-secondary">Notes</span>
      </div>

      <div class="flex flex-col items-center justify-center text-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mb-3"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-0.5-5.006L20 17"></path></svg>
        <span class="text-[36px] font-[800] text-text-title leading-none mb-1">{storiesCount}</span>
        <span class="text-[14.5px] font-[600] text-text-secondary">Stories</span>
      </div>

      <div class="flex flex-col items-center justify-center text-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mb-3"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        <span class="text-[36px] font-[800] text-text-title leading-none mb-1">{githubContribCount}</span>
        <span class="text-[14.5px] font-[600] text-text-secondary">GitHub Contributions</span>
      </div>

    </div>
  </section>

  <!-- Latest Updates Section -->
  <section class="py-16">
    <h2 class="text-sm font-bold tracking-widest text-text-secondary uppercase mb-8">Latest Updates</h2>
    
    <!-- Carousel Wrapper with Left (<) and Right (>) side arrows -->
    <div class="relative group/carousel -mx-4 px-4 md:mx-0 md:px-0">
      <!-- Left Arrow (<) -->
      <button 
        id="btn-home-prev" 
        class="absolute left-1 sm:-left-4 md:-left-5 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-white/95 dark:bg-slate-800/95 backdrop-blur-md border border-border/80 text-text-title shadow-lg hover:border-primary hover:text-primary transition-all flex items-center justify-center hover:scale-105 active:scale-95 cursor-pointer" 
        aria-label="이전 카드 보기"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
      </button>

      <!-- Right Arrow (>) -->
      <button 
        id="btn-home-next" 
        class="absolute right-1 sm:-right-4 md:-right-5 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-white/95 dark:bg-slate-800/95 backdrop-blur-md border border-border/80 text-text-title shadow-lg hover:border-primary hover:text-primary transition-all flex items-center justify-center hover:scale-105 active:scale-95 cursor-pointer" 
        aria-label="다음 카드 보기"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
      </button>

      <!-- Draggable Track -->
      <div 
        id="carousel-track-home" 
        class="flex gap-6 overflow-x-auto pb-4 pt-2 px-4 -mx-4 md:mx-0 md:px-0 snap-x md:snap-none cursor-grab active:cursor-grabbing select-none"
        style="scrollbar-width: none;"
      >
        <!-- Hide webkit scrollbar -->
        <style>
          #carousel-track-home::-webkit-scrollbar { display: none; }
        </style>

        {latestUpdates.map(item => (
          <div class="card-item shrink-0 w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] snap-center flex flex-col">
            <a href={item.href} class="group flex flex-col bg-surface rounded-[var(--radius-card)] overflow-hidden border border-border/60 hover:border-primary/50 shadow-sm hover:shadow-md transition-all duration-300 h-full no-underline">
              <!-- Thumbnail Area -->
              <div class="aspect-[16/10] bg-gray-100 dark:bg-slate-800/60 relative overflow-hidden flex flex-col items-center justify-center border-b border-border/50">
                {item.thumbnail ? (
                  <Image src={item.thumbnail} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 absolute inset-0" draggable="false" />
                ) : (
                  <div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-br from-indigo-50/50 via-white to-gray-50 dark:from-slate-800 dark:via-slate-800/80 dark:to-slate-900 text-text-muted p-4 text-center">
                    {item.type === 'Note' ? (
                      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary/70 mb-2 group-hover:scale-110 transition-transform duration-300"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    ) : (
                      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary/70 mb-2 group-hover:scale-110 transition-transform duration-300"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                    )}
                    <span class="text-[13px] font-[600] text-text-secondary">{item.type}</span>
                  </div>
                )}
              </div>

              <!-- Card Body -->
              <div class="p-6 flex flex-col flex-grow">
                <h3 class="text-[18px] font-[700] text-text-title mb-2 group-hover:text-primary transition-colors line-clamp-2 leading-[1.4]">{item.title}</h3>
                <p class="text-[14px] text-text-body/80 line-clamp-2 mb-6 leading-relaxed flex-grow">{item.description}</p>
                <div class="mt-auto pt-3 border-t border-border/40 flex items-center justify-between text-[13.5px] text-text-muted font-medium">
                  <span>{item.dateStr}</span>
                  <span class="inline-flex items-center gap-1 text-primary text-[13px] font-[600] opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all">
                    Read
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                  </span>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('carousel-track-home');
    const btnPrev = document.getElementById('btn-home-prev');
    const btnNext = document.getElementById('btn-home-next');
    if (!track) return;

    // ---- Carousel Drag & Hold-protection Logic ----
    let isDown = false;
    let startX: number;
    let scrollLeft: number;
    let suppressClick = false;
    let downTimestamp = 0;

    // Prevent native image/link dragging from conflicting with carousel scrolling
    track.querySelectorAll('a, img').forEach(el => {
      el.addEventListener('dragstart', (e) => e.preventDefault());
    });

    track.addEventListener('mousedown', (e) => {
      isDown = true;
      suppressClick = false;
      downTimestamp = Date.now();
      track.classList.add('active');
      startX = (e as MouseEvent).pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
      pauseAutoSlide();
    });

    const stopDragging = () => {
      if (!isDown) return;
      isDown = false;
      track.classList.remove('active');
    };

    // Listen to window mouseup to guarantee dragging terminates even if mouse releases outside the track!
    track.addEventListener('mouseleave', stopDragging);
    track.addEventListener('mouseup', stopDragging);
    window.addEventListener('mouseup', stopDragging);

    track.addEventListener('mousemove', (e) => {
      // Immediate failsafe: if button is not held down anymore (e.buttons === 0), stop immediately!
      if (!isDown || (e as MouseEvent).buttons === 0) {
        stopDragging();
        return;
      }
      e.preventDefault();
      const x = (e as MouseEvent).pageX - track.offsetLeft;
      const walk = (x - startX) * 1.1; 
      if (Math.abs(walk) > 3) {
        suppressClick = true;
      }
      track.scrollLeft = scrollLeft - walk;
    });

    // Suppress clicks if user dragged or held down the mouse (> 250ms)
    track.querySelectorAll('a').forEach(anchor => {
      anchor.addEventListener('click', (e) => {
        const holdDuration = Date.now() - downTimestamp;
        if (suppressClick || holdDuration > 250) {
          e.preventDefault();
          e.stopPropagation();
        }
      });
    });

    // ---- Side Arrow Navigation & Auto-slide integration ----
    let autoSlideInterval: number | null = null;
    let pauseTimeout: number | null = null;

    const getSlideWidth = () => {
      const firstCard = track.querySelector('.card-item') as HTMLElement;
      return firstCard ? firstCard.offsetWidth + 24 : 320;
    };

    const slideNext = () => {
      if (!track || isDown) return;
      const maxScroll = track.scrollWidth - track.clientWidth;
      if (track.scrollLeft >= maxScroll - 10) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: getSlideWidth(), behavior: 'smooth' });
      }
    };

    const slidePrev = () => {
      if (!track || isDown) return;
      if (track.scrollLeft <= 10) {
        track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: -getSlideWidth(), behavior: 'smooth' });
      }
    };

    if (btnPrev) {
      btnPrev.addEventListener('click', () => {
        slidePrev();
        pauseAutoSlide();
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', () => {
        slideNext();
        pauseAutoSlide();
      });
    }

    const startAutoSlide = () => {
      if (autoSlideInterval) clearInterval(autoSlideInterval);
      autoSlideInterval = window.setInterval(slideNext, 4500);
    };

    const pauseAutoSlide = () => {
      if (autoSlideInterval) {
        clearInterval(autoSlideInterval);
        autoSlideInterval = null;
      }
      if (pauseTimeout) clearTimeout(pauseTimeout);
      pauseTimeout = window.setTimeout(() => {
        if (!isDown) startAutoSlide();
      }, 8000);
    };

    track.addEventListener('mouseenter', pauseAutoSlide);
    track.addEventListener('touchstart', pauseAutoSlide, { passive: true });

    startAutoSlide();
  });
</script>
