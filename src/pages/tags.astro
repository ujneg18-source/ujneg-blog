---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Fetch all Content Collections
const allProjects = await getCollection('projects');
const allNotes = await getCollection('notes');
const allStories = await getCollection('stories');

const formattedProjects = allProjects.sort((a, b) => b.data.period.localeCompare(a.data.period)).map(item => ({
  date: item.data.period.split(' - ')[0] || item.data.period,
  title: item.data.title,
  href: `/projects/${item.id}`,
  tags: item.data.techStack || []
}));

const formattedNotes = allNotes.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).map(note => ({
  date: note.data.date.toLocaleDateString('ko-KR', { month: '2-digit', day: '2-digit' }),
  title: note.data.title,
  href: `/notes/${note.id}`,
  tags: note.data.tags || []
}));

const formattedStories = allStories.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).map(story => ({
  date: story.data.date.toLocaleDateString('ko-KR', { month: '2-digit', day: '2-digit' }),
  title: story.data.title,
  href: `/stories/${story.id}`,
  tags: story.data.tags || []
}));

// Extract Tags & Frequencies from ALL content collections
const allTags = [...formattedProjects, ...formattedNotes, ...formattedStories].flatMap(item => item.tags);
const tagCounts = allTags.reduce((acc, tag) => {
  acc[tag] = (acc[tag] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]); // sort by frequency descending
const totalTags = sortedTags.length;

// Helper to calculate styling based on frequency
const getMaxFreq = () => Math.max(...Object.values(tagCounts), 1);
const maxFreq = getMaxFreq();

function getTagStyles(freq: number) {
  if (freq >= maxFreq) return "text-[14px] font-[600] text-gray-700 dark:text-slate-300 px-3 py-1";
  if (freq >= 2) return "text-[13.5px] font-[500] text-gray-600 dark:text-slate-400 px-2.5 py-1";
  return "text-[13px] font-[400] text-gray-500 dark:text-slate-400 px-2 py-1";
}
---

<Layout title="Tags & Archives">
  <div class="w-full flex flex-col">
    
    <!-- Top Section: Projects / Notes / Stories Columns -->
    <section class="mb-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-6">
        
        <!-- Projects Column -->
        <div class="flex flex-col min-w-0">
          <h2 class="text-[22px] font-[800] text-text-title mb-5 border-b border-border/60 pb-3">Projects</h2>
          <ul class="flex flex-col gap-1.5 m-0 p-0 list-none">
            {formattedProjects.map((item) => (
              <li class="m-0">
                <a href={item.href} class="flex items-start gap-3 py-1.5 px-2 -mx-2 rounded-lg hover:bg-surface/80 transition-colors group no-underline">
                  <span class="text-[13.5px] text-text-muted font-[400] shrink-0 pt-[2px]">{item.date}</span>
                  <span class="text-[14.5px] font-[500] text-text-body group-hover:text-primary transition-colors leading-[1.45] break-keep">{item.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Notes Column -->
        <div class="flex flex-col min-w-0">
          <h2 class="text-[22px] font-[800] text-text-title mb-5 border-b border-border/60 pb-3">Notes</h2>
          <ul class="flex flex-col gap-1.5 m-0 p-0 list-none">
            {formattedNotes.map((item) => (
              <li class="m-0">
                <a href={item.href} class="flex items-start gap-3 py-1.5 px-2 -mx-2 rounded-lg hover:bg-surface/80 transition-colors group no-underline">
                  <span class="text-[13.5px] text-text-muted font-[400] shrink-0 pt-[2px]">{item.date}</span>
                  <span class="text-[14.5px] font-[500] text-text-body group-hover:text-primary transition-colors leading-[1.45] break-keep">{item.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Stories Column -->
        <div class="flex flex-col min-w-0">
          <h2 class="text-[22px] font-[800] text-text-title mb-5 border-b border-border/60 pb-3">Stories</h2>
          <ul class="flex flex-col gap-1.5 m-0 p-0 list-none">
            {formattedStories.map((item) => (
              <li class="m-0">
                <a href={item.href} class="flex items-start gap-3 py-1.5 px-2 -mx-2 rounded-lg hover:bg-surface/80 transition-colors group no-underline">
                  <span class="text-[13.5px] text-text-muted font-[400] shrink-0 pt-[2px]">{item.date}</span>
                  <span class="text-[14.5px] font-[500] text-text-body group-hover:text-primary transition-colors leading-[1.45] break-keep">{item.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </section>

    <!-- Bottom Section: Tag Cloud -->
    <section class="mt-8 md:mt-12 bg-surface/50 p-8 md:p-12 rounded-[var(--radius-card)] border border-border/50">
      <h2 class="text-[28px] font-[800] text-text-title mb-8">{totalTags} TAGS</h2>
      <div class="flex flex-wrap items-center gap-3 md:gap-4">
        {sortedTags.map(([tag, count]) => (
          <a 
            href={`/tags/${tag}`}
            class={`inline-flex items-center gap-1.5 bg-white dark:bg-slate-800 border border-border/70 hover:border-primary/50 shadow-sm rounded-full transition-all no-underline ${getTagStyles(count)}`}
          >
            #{tag}
            <span class="tag-badge bg-gray-100 dark:bg-slate-700/50 text-text-muted px-2 py-0.5 rounded-full text-[12px] font-medium transition-colors">
              {count}
            </span>
          </a>
        ))}
      </div>
    </section>

  </div>
</Layout>
