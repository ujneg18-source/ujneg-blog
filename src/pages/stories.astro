---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import storyThumb1Img from '../assets/images/story-thumb-1.png';
import storyThumb2Img from '../assets/images/story-thumb-2.png';
import storyThumb3Img from '../assets/images/story-thumb-3.png';
---

<Layout title="Stories">
  <div class="flex flex-col gap-12">
    <!-- Hero Title -->
    <div class="pt-8">
      <h1 class="font-extrabold leading-[1.1] tracking-tight bg-gradient-to-r from-slate-900 to-blue-600 text-transparent bg-clip-text" style="font-size: 56px; font-weight: 800;">
        MOMENTS,<br/>
        IN WORDS.
      </h1>
    </div>

    <!-- Filter Tabs & Sort -->
    <div class="flex flex-col md:flex-row md:items-center justify-between mt-4 gap-4">
      <div id="filter-tabs" class="flex items-center gap-2 overflow-x-auto pb-2 -mb-2 md:pb-0 md:mb-0">
        <!-- Filter buttons now have data-category and semantic classes for JS toggling -->
        <button data-category="all" class="filter-tab inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-50 border border-indigo-100 text-primary font-[600] text-[14px] whitespace-nowrap transition-colors">
          전체 <span class="badge bg-white dark:bg-slate-800/60 text-primary px-2 py-0.5 rounded-full text-[12px] transition-colors">10</span>
        </button>
        <button data-category="일상" class="filter-tab inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface border border-border text-text-secondary hover:bg-gray-50 dark:bg-slate-800/50 font-[500] text-[14px] whitespace-nowrap transition-colors">
          일상 <span class="badge bg-gray-100 dark:bg-slate-700/50 text-text-muted px-2 py-0.5 rounded-full text-[12px] transition-colors">1</span>
        </button>
        <button data-category="프로젝트" class="filter-tab inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface border border-border text-text-secondary hover:bg-gray-50 dark:bg-slate-800/50 font-[500] text-[14px] whitespace-nowrap transition-colors">
          프로젝트 <span class="badge bg-gray-100 dark:bg-slate-700/50 text-text-muted px-2 py-0.5 rounded-full text-[12px] transition-colors">1</span>
        </button>
        <button data-category="JavaScript" class="filter-tab inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface border border-border text-text-secondary hover:bg-gray-50 dark:bg-slate-800/50 font-[500] text-[14px] whitespace-nowrap transition-colors">
          JavaScript <span class="badge bg-gray-100 dark:bg-slate-700/50 text-text-muted px-2 py-0.5 rounded-full text-[12px] transition-colors">4</span>
        </button>
        <button data-category="Web" class="filter-tab inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface border border-border text-text-secondary hover:bg-gray-50 dark:bg-slate-800/50 font-[500] text-[14px] whitespace-nowrap transition-colors">
          Web <span class="badge bg-gray-100 dark:bg-slate-700/50 text-text-muted px-2 py-0.5 rounded-full text-[12px] transition-colors">4</span>
        </button>
      </div>

      <!-- Sort Dropdown -->
      <div class="flex-shrink-0 relative">
        <button id="sort-toggle-btn" class="inline-flex items-center justify-between w-[110px] px-4 py-2 rounded-[var(--radius-card)] bg-surface border border-border text-text-secondary font-[500] text-[14px] hover:bg-gray-50 dark:bg-slate-800/50 transition-colors">
          <span id="sort-label">최신순</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
        </button>
        
        <!-- Dropdown Menu -->
        <div id="sort-menu" class="absolute right-0 mt-2 w-full bg-white dark:bg-slate-800 border border-border/50 shadow-lg rounded-xl overflow-hidden z-20 hidden">
          <button class="sort-option w-full text-left px-4 py-2.5 text-[14px] hover:bg-gray-50 dark:bg-slate-800/50 text-gray-700 dark:text-slate-300 transition-colors font-medium" data-sort="desc">최신순</button>
          <button class="sort-option w-full text-left px-4 py-2.5 text-[14px] hover:bg-gray-50 dark:bg-slate-800/50 text-gray-700 dark:text-slate-300 transition-colors font-medium" data-sort="asc">오래된순</button>
        </div>
      </div>
    </div>

    <!-- Stories List -->
    <div id="stories-list" class="flex flex-col gap-6 mt-4" data-pagefind-body>
      
      <!-- Story 1 -->
      <article data-date="2024.08.04" data-category="일상" class="story-item bg-surface rounded-[var(--radius-card)] border border-border/50 shadow-sm flex flex-col md:flex-row overflow-hidden group">
        <div class="w-full md:w-[280px] lg:w-[320px] shrink-0 aspect-[4/3] md:aspect-square overflow-hidden border-b md:border-b-0 md:border-r border-border/50">
          <Image src={storyThumb1Img} alt="Thumbnail 1" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="p-6 md:p-8 flex flex-col justify-center flex-1 min-w-0">
          <div class="flex items-center gap-2 text-[14px] mb-3">
            <span class="font-[600] text-primary">일상</span>
            <span class="text-text-muted">·</span>
            <span class="text-text-muted">2024.08.04</span>
          </div>
          <h2 class="text-[22px] font-[700] text-text-title mb-2 group-hover:text-primary transition-colors truncate">
            <a href="#">최근 근황과 블로그 방향에 대해</a>
          </h2>
          <p class="text-[15px] text-text-body line-clamp-1 leading-[1.6]">
            이것저것 하면서 바쁘게 지내는 한 편, 앞으로 블로그를 어떻게 세워나가면 좋을까 고민한 결과를 정리했습니다.
          </p>
        </div>
      </article>

      <!-- Story 2 -->
      <article data-date="2023.12.04" data-category="프로젝트" class="story-item bg-surface rounded-[var(--radius-card)] border border-border/50 shadow-sm flex flex-col md:flex-row overflow-hidden group">
        <div class="w-full md:w-[280px] lg:w-[320px] shrink-0 aspect-[4/3] md:aspect-square overflow-hidden border-b md:border-b-0 md:border-r border-border/50">
          <Image src={storyThumb2Img} alt="Thumbnail 2" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="p-6 md:p-8 flex flex-col justify-center flex-1 min-w-0">
          <div class="flex items-center gap-2 text-[14px] mb-3">
            <span class="font-[600] text-indigo-600">프로젝트</span>
            <span class="text-text-muted">·</span>
            <span class="text-text-muted">2023.12.04</span>
          </div>
          <h2 class="text-[22px] font-[700] text-text-title mb-2 group-hover:text-primary transition-colors truncate">
            <a href="#">Astro로 만들어 본 나만의 블로그</a>
          </h2>
          <p class="text-[15px] text-text-body line-clamp-1 leading-[1.6]">
            예전부터 갖고 싶었던 나만의 개발 블로그를 만들면서 얻은 경험을 공유합니다.
          </p>
        </div>
      </article>

      <!-- Story 3 -->
      <article data-date="2022.01.09" data-category="JavaScript" class="story-item bg-surface rounded-[var(--radius-card)] border border-border/50 shadow-sm flex flex-col md:flex-row overflow-hidden group">
        <div class="w-full md:w-[280px] lg:w-[320px] shrink-0 aspect-[4/3] md:aspect-square overflow-hidden border-b md:border-b-0 md:border-r border-border/50">
          <Image src={storyThumb3Img} alt="Thumbnail 3" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        </div>
        <div class="p-6 md:p-8 flex flex-col justify-center flex-1 min-w-0">
          <div class="flex items-center gap-2 text-[14px] mb-3">
            <span class="font-[600] text-teal-600">JavaScript</span>
            <span class="text-text-muted">·</span>
            <span class="text-text-muted">2022.01.09</span>
          </div>
          <h2 class="text-[22px] font-[700] text-text-title mb-2 group-hover:text-primary transition-colors truncate">
            <a href="#">Slick 같은 무한 루프 슬라이드 만들기</a>
          </h2>
          <p class="text-[15px] text-text-body line-clamp-1 leading-[1.6]">
            흔히 볼 수 있는 슬라이드 UI를 가볍게 구현하는 방법을 소개합니다.
          </p>
        </div>
      </article>

    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // ---- 1. Sort Logic ----
    const toggleBtn = document.getElementById('sort-toggle-btn');
    const sortMenu = document.getElementById('sort-menu');
    const sortLabel = document.getElementById('sort-label');
    const options = document.querySelectorAll('.sort-option');
    const listContainer = document.getElementById('stories-list');
    
    if (toggleBtn && sortMenu && listContainer) {
      // Toggle menu
      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        sortMenu.classList.toggle('hidden');
      });

      // Close menu when clicking outside
      document.addEventListener('click', () => {
        sortMenu.classList.add('hidden');
      });

      // Handle sort options
      options.forEach(option => {
        option.addEventListener('click', () => {
          const order = option.getAttribute('data-sort');
          const text = option.textContent;
          
          if (text) {
            sortLabel.textContent = text;
          }
          sortMenu.classList.add('hidden');
          
          // Sort items
          const items = Array.from(listContainer.querySelectorAll('.story-item'));
          items.sort((a, b) => {
            const dateA = a.getAttribute('data-date') || '';
            const dateB = b.getAttribute('data-date') || '';
            
            if (order === 'desc') {
              return dateB.localeCompare(dateA); // Newest first
            } else {
              return dateA.localeCompare(dateB); // Oldest first
            }
          });
          
          // Re-append in sorted order (DOM automatically moves them)
          items.forEach(item => listContainer.appendChild(item));
        });
      });
    }

    // ---- 2. Filter Logic ----
    const filterTabs = document.querySelectorAll('.filter-tab');
    const storyItems = document.querySelectorAll('.story-item');

    // Define styling classes
    const activeBtnClasses = ['bg-indigo-50', 'border-indigo-100', 'text-primary', 'font-[600]'];
    const activeBadgeClasses = ['bg-white dark:bg-slate-800/60', 'text-primary'];
    const inactiveBtnClasses = ['bg-surface', 'border-border', 'text-text-secondary', 'hover:bg-gray-50 dark:bg-slate-800/50', 'font-[500]'];
    const inactiveBadgeClasses = ['bg-gray-100 dark:bg-slate-700/50', 'text-text-muted'];

    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetCategory = tab.getAttribute('data-category');

        // 1. Update active tab UI
        filterTabs.forEach(t => {
          const badge = t.querySelector('.badge');
          if (t === tab) {
            // Set active styles
            t.classList.remove(...inactiveBtnClasses);
            t.classList.add(...activeBtnClasses);
            if (badge) {
              badge.classList.remove(...inactiveBadgeClasses);
              badge.classList.add(...activeBadgeClasses);
            }
          } else {
            // Set inactive styles
            t.classList.remove(...activeBtnClasses);
            t.classList.add(...inactiveBtnClasses);
            if (badge) {
              badge.classList.remove(...activeBadgeClasses);
              badge.classList.add(...inactiveBadgeClasses);
            }
          }
        });

        // 2. Filter stories (show/hide based on data-category)
        // Since sort re-appends elements, display:none is perfectly independent and preserves order!
        storyItems.forEach(item => {
          const itemCategory = item.getAttribute('data-category');
          if (targetCategory === 'all' || itemCategory === targetCategory) {
            item.style.display = ''; // reset to default flex
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
</script>
