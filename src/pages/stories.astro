---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

const allStories = await getCollection('stories');
const stories = allStories.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Calculate category counts dynamically
const categories = [
  { id: 'all', label: '전체' },
  { id: '일상', label: '일상' },
  { id: '프로젝트', label: '프로젝트' },
  { id: 'JavaScript', label: 'JavaScript' },
  { id: 'Web', label: 'Web' },
];

const categoryCounts: Record<string, number> = {
  all: stories.length,
};
categories.slice(1).forEach(cat => {
  categoryCounts[cat.id] = stories.filter(s => s.data.category === cat.id).length;
});

function formatDate(date: Date): string {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${y}.${m}.${d}`;
}
---

<Layout title="Stories">
  <div class="flex flex-col gap-12">
    <!-- Hero Title -->
    <div>
      <h1 class="text-hero-heading">
        MOMENTS,<br/>
        <span class="text-gradient-hero">IN WORDS.</span>
      </h1>
    </div>

    <!-- Filter Tabs & Sort -->
    <div class="flex flex-col md:flex-row md:items-center justify-between mt-4 gap-4">
      <div id="filter-tabs" class="flex items-center gap-2 overflow-x-auto pb-2 -mb-2 md:pb-0 md:mb-0">
        {categories.map((cat, idx) => {
          const count = categoryCounts[cat.id] || 0;
          const isFirst = idx === 0;
          return (
            <button 
              data-category={cat.id} 
              class={`filter-tab inline-flex items-center gap-2 px-4 py-2 rounded-full whitespace-nowrap transition-colors text-[14px] ${
                isFirst 
                  ? 'bg-indigo-50 border border-indigo-100 text-primary font-[600]' 
                  : 'bg-surface border border-border text-text-secondary hover:bg-gray-50 dark:bg-slate-800/50 font-[500]'
              }`}
            >
              {cat.label} 
              <span class={`badge px-2 py-0.5 rounded-full text-[12px] transition-colors ${
                isFirst 
                  ? 'bg-white dark:bg-slate-800/60 text-primary' 
                  : 'bg-gray-100 dark:bg-slate-700/50 text-text-muted'
              }`}>
                {count}
              </span>
            </button>
          );
        })}
      </div>

      <!-- Sort Dropdown -->
      <div class="flex-shrink-0 relative">
        <button id="sort-toggle-btn" class="inline-flex items-center justify-between w-[110px] px-4 py-2 rounded-[var(--radius-card)] bg-surface border border-border text-text-secondary font-[500] text-[14px] hover:bg-gray-50 dark:bg-slate-800/50 transition-colors">
          <span id="sort-label">최신순</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
        </button>
        
        <!-- Dropdown Menu -->
        <div id="sort-menu" class="absolute right-0 mt-2 w-full bg-white dark:bg-slate-800 border border-border/50 shadow-lg rounded-xl overflow-hidden z-20 hidden">
          <button class="sort-option w-full text-left px-4 py-2.5 text-[14px] hover:bg-gray-50 dark:bg-slate-800/50 text-gray-700 dark:text-slate-300 transition-colors font-medium" data-sort="desc">최신순</button>
          <button class="sort-option w-full text-left px-4 py-2.5 text-[14px] hover:bg-gray-50 dark:bg-slate-800/50 text-gray-700 dark:text-slate-300 transition-colors font-medium" data-sort="asc">오래된순</button>
        </div>
      </div>
    </div>

    <!-- Stories List -->
    <div id="stories-list" class="flex flex-col gap-6 mt-4" data-pagefind-body>
      
      {stories.map((story, idx) => {
        const formattedDate = formatDate(story.data.date);
        return (
          <article 
            data-date={formattedDate} 
            data-category={story.data.category} 
            class="story-item bg-surface rounded-[var(--radius-card)] border border-border/50 shadow-sm flex flex-col md:flex-row overflow-hidden group transition-all duration-300 hover:shadow-md"
            style={idx >= 4 ? 'display: none;' : ''}
          >
            <div class="w-full md:w-[280px] lg:w-[320px] shrink-0 aspect-[4/3] md:aspect-square overflow-hidden border-b md:border-b-0 md:border-r border-border/50 bg-gray-100 dark:bg-slate-800/50">
              {story.data.thumbnail ? (
                <Image src={story.data.thumbnail} alt={story.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-text-muted text-sm">No Thumbnail</div>
              )}
            </div>
            <div class="p-6 md:p-8 flex flex-col justify-center flex-1 min-w-0">
              <div class="flex items-center gap-2 text-[14px] mb-3">
                <span class="font-[600] text-primary">{story.data.category}</span>
                <span class="text-text-muted">·</span>
                <time class="text-text-muted">{formattedDate}</time>
              </div>
              <h2 class="text-[22px] font-[700] text-text-title mb-2 group-hover:text-primary transition-colors truncate">
                <a href={`/stories/${story.id}`} class="no-underline text-inherit hover:text-primary">
                  {story.data.title}
                </a>
              </h2>
              <p class="text-[15px] text-text-body line-clamp-2 leading-[1.6]">
                {story.data.description}
              </p>
            </div>
          </article>
        );
      })}

    </div>

    <!-- View More Toggle Button Container -->
    <div id="stories-view-more-container" class="w-full flex justify-center mt-4 mb-8" style={stories.length <= 4 ? 'display: none;' : ''}>
      <button 
        id="stories-view-more-btn" 
        class="inline-flex items-center gap-2.5 px-8 py-3.5 rounded-full bg-surface border border-border/80 hover:border-primary text-text-title text-[15px] font-[700] hover:text-primary transition-all shadow-sm hover:shadow-md cursor-pointer select-none group"
      >
        <span>View More</span>
        <svg id="stories-view-more-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary transition-transform duration-300 ease-in-out"><path d="m6 9 6 6 6-6"></path></svg>
      </button>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const listContainer = document.getElementById('stories-list');
    const viewMoreBtn = document.getElementById('stories-view-more-btn') as HTMLElement | null;
    const viewMoreContainer = document.getElementById('stories-view-more-container') as HTMLElement | null;
    const icon = document.getElementById('stories-view-more-icon') as HTMLElement | null;
    const storyItems = Array.from(document.querySelectorAll('.story-item')) as HTMLElement[];

    // ---- View More Toggle Controller (Shared Pattern) ----
    let isExpanded = false;

    function updateViewMore() {
      if (!listContainer || !viewMoreContainer) return;
      const currentItems = Array.from(listContainer.querySelectorAll('.story-item')) as HTMLElement[];
      const activeItems = currentItems.filter(item => !item.hasAttribute('data-category-hidden'));

      currentItems.forEach((item) => {
        if (item.hasAttribute('data-category-hidden')) {
          item.style.display = 'none';
        }
      });

      if (activeItems.length <= 4) {
        viewMoreContainer.style.display = 'none';
        activeItems.forEach(item => item.style.display = '');
        return;
      }

      viewMoreContainer.style.display = 'flex';

      activeItems.forEach((item, idx) => {
        if (!isExpanded && idx >= 4) {
          item.style.display = 'none';
        } else {
          item.style.display = '';
        }
      });

      if (icon) {
        icon.style.transform = isExpanded ? 'rotate(180deg)' : 'rotate(0deg)';
      }
    }

    // Initial check
    updateViewMore();

    if (viewMoreBtn) {
      viewMoreBtn.addEventListener('click', () => {
        isExpanded = !isExpanded;
        updateViewMore();
      });
    }

    // ---- 1. Sort Logic ----
    const toggleBtn = document.getElementById('sort-toggle-btn');
    const sortMenu = document.getElementById('sort-menu');
    const sortLabel = document.getElementById('sort-label');
    const options = document.querySelectorAll('.sort-option');
    
    if (toggleBtn && sortMenu && listContainer) {
      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        sortMenu.classList.toggle('hidden');
      });

      document.addEventListener('click', () => {
        sortMenu.classList.add('hidden');
      });

      options.forEach(option => {
        option.addEventListener('click', () => {
          const order = option.getAttribute('data-sort');
          const text = option.textContent;
          
          if (text && sortLabel) {
            sortLabel.textContent = text;
          }
          sortMenu.classList.add('hidden');
          
          const items = Array.from(listContainer.querySelectorAll('.story-item'));
          items.sort((a, b) => {
            const dateA = a.getAttribute('data-date') || '';
            const dateB = b.getAttribute('data-date') || '';
            
            if (order === 'desc') {
              return dateB.localeCompare(dateA);
            } else {
              return dateA.localeCompare(dateB);
            }
          });
          
          items.forEach(item => listContainer.appendChild(item));
          updateViewMore();
        });
      });
    }

    // ---- 2. Filter Logic ----
    const filterTabs = document.querySelectorAll('.filter-tab');

    const activeBtnClasses = ['bg-indigo-50', 'border-indigo-100', 'text-primary', 'font-[600]'];
    const activeBadgeClasses = ['bg-white', 'dark:bg-slate-800/60', 'text-primary'];
    const inactiveBtnClasses = ['bg-surface', 'border-border', 'text-text-secondary', 'hover:bg-gray-50', 'dark:bg-slate-800/50', 'font-[500]'];
    const inactiveBadgeClasses = ['bg-gray-100', 'dark:bg-slate-700/50', 'text-text-muted'];

    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetCategory = tab.getAttribute('data-category');

        filterTabs.forEach(t => {
          const badge = t.querySelector('.badge');
          if (t === tab) {
            t.classList.remove(...inactiveBtnClasses);
            t.classList.add(...activeBtnClasses);
            if (badge) {
              badge.classList.remove(...inactiveBadgeClasses);
              badge.classList.add(...activeBadgeClasses);
            }
          } else {
            t.classList.remove(...activeBtnClasses);
            t.classList.add(...inactiveBtnClasses);
            if (badge) {
              badge.classList.remove(...activeBadgeClasses);
              badge.classList.add(...inactiveBadgeClasses);
            }
          }
        });

        storyItems.forEach(item => {
          const itemCategory = item.getAttribute('data-category');
          if (targetCategory === 'all' || itemCategory === targetCategory) {
            item.removeAttribute('data-category-hidden');
          } else {
            item.setAttribute('data-category-hidden', 'true');
          }
        });

        isExpanded = false;
        updateViewMore();
      });
    });
  });
</script>
